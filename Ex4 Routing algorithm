#include "dijkstra.h"

int main()
{
    int n;
    int cost[MAX][MAX];
    int distance[MAX];
    int parent[MAX];
    int source, destination;
    getInput(cost, &n, &source, &destination);
    dijkstra(cost, n, source, distance, parent);
    if (destination < 0 || destination >= n)
    {
        displayRoutingTable(distance, parent, n, source);
    }
    else
    {
        displayPath(distance, parent, source, destination);
    }

    return 0;
}

