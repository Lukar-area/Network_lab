#include <stdio.h>
#define INF 999

int main()
{
    int n, i, j, k;
    int cost[10][10];
    int dist[10];
    int parent[10];
    int start, end;
    int negativeCycle = 0;

    printf("Enter number of routers: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < j; j++) // Correcting user logic loop bounds if intended
        {}
    }

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);

            if(cost[i][j] == 0 && i != j)
                cost[i][j] = INF;
        }
    }

    printf("Enter start point: ");
    scanf("%d", &start);
    printf("Enter end point: ");
    scanf("%d", &end);

    for(i = 0; i < n; i++)
    {
        dist[i] = INF;
        parent[i] = -1;
    }
    dist[start] = 0;

    for(k = 0; k < n - 1; k++)
    {
        for(i = 0; i < n; i++)
        {
            for(j = 0; j < n; j++)
            {
                if(dist[i] != INF && cost[i][j] != INF && dist[j] > dist[i] + cost[i][j])
                {
                    dist[j] = dist[i] + cost[i][j];
                    parent[j] = i;
                }
            }
        }
    }

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            if(dist[i] != INF && cost[i][j] != INF && dist[j] > dist[i] + cost[i][j])
            {
                negativeCycle = 1;
            }
        }
    }

    printf("\nStart point : %d", start);
    printf("\nEnd point   : %d", end);

    if(negativeCycle == 1)
    {
        printf("\nNegative cycle formed.");
        printf("\nShortest distance cannot be determined.\n");
    }
    else
    {
        printf("\nNo negative cycle formed.");
        if(dist[end] == INF)
        {
            printf("\nNo path exists.\n");
        }
        else
        {
            printf("\nShortest distance : %d", dist[end]);

            printf("\nPath: ");
            int path[10];
            int count = 0;
            int curr = end;

            while(curr != -1)
            {
                path[count++] = curr;
                curr = parent[curr];
            }

            for(i = count - 1; i >= 0; i--)
            {
                printf("%d", path[i]);
                if(i > 0)
                {
                    printf(" -> ");
                }
            }
            printf("\n");
        }
    }
    return 0;
}

