#include <stdio.h>
#include "dijkstra.h"
void getInput(int cost[MAX][MAX], int *n, int *source, int *destination)
{
    int i, j;
    printf("Enter number of vertices: ");
    scanf("%d", n);
    printf("\nEnter the cost matrix:\n");
    for (i = 0; i < *n; i++)
    {
        for (j = 0; j < *n; j++)
        {
            printf("Cost from %d to %d: ", i + 1, j + 1);
            scanf("%d", &cost[i][j]);

            if (i != j && cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }
    printf("\nEnter source vertex: ");
    scanf("%d", source);
    printf("Enter destination vertex: ");
    scanf("%d", destination);
    (*source)--;
    if (*destination != -1)
    {
        (*destination)--;
    }
}
void dijkstra(int cost[MAX][MAX], int n, int source,int distance[MAX], int parent[MAX])
{
    int visited[MAX];
    int i, j;
    int min, u;
    for (i = 0; i < n; i++)
    {
        distance[i] = INF;
        visited[i] = 0;
        parent[i] = -1;
    }
    distance[source] = 0;
    for (i = 0; i < n; i++)
    {
        min = INF;
        u = -1;
        for (j = 0; j < n; j++)
        {
            if (!visited[j] && distance[j] < min)
            {
                min = distance[j];
                u = j;
            }
        }

        if (u == -1)
            break;
        visited[u] = 1;
        for (j = 0; j < n; j++)
        {
            if (!visited[j] &&cost[u][j] != INF &&distance[u] + cost[u][j] < distance[j])
            {
                distance[j] = distance[u] + cost[u][j];
                parent[j] = u;
            }
        }
    }
}
void displayPath(int distance[MAX], int parent[MAX], int source, int destination)
{
    printf("\n%-15s %-10s %-10s\n", "Destination", "Cost", "Nexthop");
    printf("----------------------------------------\n");

    if (distance[destination] == INF)
    {
        printf("%-15d %-10s %-10s\n", destination + 1, "INF", "-");
        return;
    }

    if (destination == source)
    {
        printf("%-15d %-10d %-10s\n", destination + 1, 0, "Self");
        return;
    }
    int next_hop = destination;
    while (parent[next_hop] != source && parent[next_hop] != -1)
    {
        next_hop = parent[next_hop];
    }

    printf("%-15d %-10d %-10d\n", destination + 1, distance[destination], next_hop + 1);
}
void displayRoutingTable(int distance[MAX], int parent[MAX], int n, int source)
{
    printf("\nRouting Table for Source Node %d:\n\n", source + 1);
    printf("%-15s %-10s %-10s\n", "Destination", "Cost", "Nexthop");
    printf("----------------------------------------\n");
    int i;
    for ( i = 0; i < n; i++)
    {
        if (i == source)
        {
            printf("%-15d %-10d %-10s\n", i + 1, 0, "Self");
            continue;
        }

        if (distance[i] == INF)
        {
            printf("%-15d %-10s %-10s\n", i + 1, "INF", "-");
            continue;
        }

        int next_hop = i;
        while (parent[next_hop] != source && parent[next_hop] != -1)
        {
            next_hop = parent[next_hop];
        }

        printf("%-15d %-10d %-10d\n", i + 1, distance[i], next_hop + 1);
    }
}
