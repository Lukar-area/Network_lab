#include <stdlib.h>

int cmp(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    int* res = (int*)malloc(sizeof(int) * arrSize * 32);
    int resSize = 0;
    int left = 0, right = 0;

    for (int i = 0; i < arrSize; i++) {
        int nextRight = resSize;
        res[resSize++] = arr[i];

        for (int j = left; j < right; j++) {
            int val = res[j] | arr[i];
            if (res[resSize - 1] != val) {
                res[resSize++] = val;
            }
        }
        
        int writeIdx = nextRight + 1;
        for (int j = nextRight + 1; j < resSize; j++) {
            if (res[j] != res[writeIdx - 1]) {
                res[writeIdx++] = res[j];
            }
        }
        resSize = writeIdx;
        left = nextRight;
        right = resSize;
    }

    // Fast O(N log N) sorting using qsort instead of O(N^2) insertion sort
    qsort(res, resSize, sizeof(int), cmp);

    int distinctCount = 0;
    if (resSize > 0) {
        distinctCount = 1;
        for (int i = 1; i < resSize; i++) {
            if (res[i] != res[i - 1]) {
                res[distinctCount++] = res[i];
            }
        }
    }

    free(res);
    return distinctCount;
}
