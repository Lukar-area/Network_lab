#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>

#define PORT 8000

int main() {
    int s, c, r;
    struct sockaddr_in a, b;
    socklen_t len = sizeof(b);
    char buf[100], host[100], ip[100];

    s = socket(AF_INET, SOCK_STREAM, 0);
    if (s < 0) {
        perror("socket");
        exit(1);
    }

    a.sin_family = AF_INET;
    a.sin_port = htons(PORT);
    a.sin_addr.s_addr = INADDR_ANY;

    if (bind(s, (struct sockaddr *)&a, sizeof(a)) < 0) {
        perror("bind");
        exit(1);
    }

    if (listen(s, 5) < 0) {
        perror("listen");
        exit(1);
    }

    printf("Server waiting...\n");

    c = accept(s, (struct sockaddr *)&b, &len);
    if (c < 0) {
        perror("accept");
        exit(1);
    }

    while (1) {
        r = recv(c, buf, sizeof(buf) - 1, 0);

        if (r <= 0)
            break;

        buf[r] = '\0';
        buf[strcspn(buf, "\n")] = '\0';

        FILE *f = fopen("data.txt", "r");

        if (f == NULL) {
            send(c, "File error", 10, 0);
            continue;
        }

        int found = 0;

        while (fscanf(f, "%s %s", host, ip) == 2) {
            if (strcmp(host, buf) == 0) {
                send(c, ip, strlen(ip), 0);
                printf("Found hostname: %s\n", host);
                found = 1;
                break;
            }
        }

        fclose(f);

        if (!found) {
            strcpy(ip, "Hostname not found");
            send(c, ip, strlen(ip), 0);
            printf("Hostname not found\n");
        }
    }

    close(c);
    close(s);

    return 0;
}
