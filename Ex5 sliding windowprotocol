#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <sys/time.h>

#define PORT 8082
#define SIZE 100
#define WINDOW_SIZE 7
#define FRAME_SIZE 8
#define MAX_CODEWORD 32

typedef struct {
    int seq, len;
    char codeword[MAX_CODEWORD];
} Frame;

typedef struct {
    char generator[SIZE];
    int mode, frameCount;
} Config;

typedef struct {
    char type[8];
    int number;
} Ack;

int sendAll(int s, void *p, int n)
{
    int x = 0, r;
    while (x < n) {
        r = send(s, (char *)p + x, n - x, 0);
        if (r <= 0) return -1;
        x += r;
    }
    return x;
}

int recvAll(int s, void *p, int n)
{
    int x = 0, r;
    while (x < n) {
        r = recv(s, (char *)p + x, n - x, 0);
        if (r <= 0) return -1;
        x += r;
    }
    return x;
}

int crcCreate(char *data, char *gen, char *code)
{
    char t[MAX_CODEWORD];
    int n = strlen(data), g = strlen(gen), i, j;

    if (g < 2 || n + g - 1 >= MAX_CODEWORD)
        return 0;

    strcpy(t, data);

    for (i = 0; i < g - 1; i++)
        t[n+i] = '0';

    for (i = 0; i < n; i++)
        if (t[i] == '1')
            for (j = 0; j < g; j++)
                t[i+j] = (t[i+j] == gen[j]) ? '0' : '1';

    strcpy(code, data);

    for (i = 0; i < g - 1; i++)
        code[n+i] = t[n+i];

    code[n+g-1] = '\0';
    return 1;
}

void makeFrame(Frame *f, int n, char *code)
{
    memset(f, 0, sizeof(Frame));
    f->seq = n;
    f->len = strlen(code);
    strcpy(f->codeword, code);
}

void corrupt(Frame *f)
{
    f->codeword[0] = f->codeword[0] == '0' ? '1' : '0';
}

int getAck(int s, Ack *a)
{
    return recvAll(s, a, sizeof(Ack));
}

int main()
{
    int sock, mode, frameCount;
    int base = 0, next = 0, ack, i;
    int lossDone = 0, errorDone = 0, retries;
    char data[SIZE], generator[SIZE];
    char frames[SIZE][FRAME_SIZE + 1];
    char codes[SIZE][MAX_CODEWORD];
    struct sockaddr_in sa;
    struct timeval tv;
    Config cfg;
    Ack a;

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) {
        printf("Socket creation failed\n");
        return 1;
    }

    tv.tv_sec = 2;
    tv.tv_usec = 0;
    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));

    memset(&sa, 0, sizeof(sa));
    sa.sin_family = AF_INET;
    sa.sin_port = htons(PORT);
    sa.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sock, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
        printf("Connection failed\n");
        return 1;
    }

    printf("TCP Sliding Window Client\n");
    printf("Enter binary data: ");
    scanf("%99s", data);

    if (strlen(data) == 0 || strlen(data) % FRAME_SIZE != 0) {
        printf("Data length must be a multiple of 8\n");
        return 1;
    }

    printf("Enter CRC generator: ");
    scanf("%99s", generator);

    do {
        printf("\n1. Data Loss\n");
        printf("2. Acknowledgement Loss\n");
        printf("3. CRC Error\n");
        printf("4. Successful Transmission\n");
        printf("Enter test case: ");
        scanf("%d", &mode);
    } while (mode < 1 || mode > 4);

    frameCount = strlen(data) / FRAME_SIZE;

    memset(&cfg, 0, sizeof(cfg));
    strcpy(cfg.generator, generator);
    cfg.mode = mode;
    cfg.frameCount = frameCount;
    sendAll(sock, &cfg, sizeof(cfg));

    for (i = 0; i < frameCount; i++) {
        memcpy(frames[i], data + i * FRAME_SIZE, FRAME_SIZE);
        frames[i][FRAME_SIZE] = '\0';

        if (!crcCreate(frames[i], generator, codes[i])) {
            printf("CRC generation failed\n");
            return 1;
        }
    }

    printf("\nWindow size : %d\n", WINDOW_SIZE);
    printf("Frame size  : %d bits\n", FRAME_SIZE);
    printf("Total frames: %d\n\n", frameCount);

    while (base < frameCount) {

        while (next < frameCount && next < base + WINDOW_SIZE) {
            Frame f;
            makeFrame(&f, next, codes[next]);

            if (mode == 1 && next == 3 && !lossDone) {
                printf("Frame %d : DATA LOSS\n", next);
                lossDone = 1;
            } else {
                if (mode == 3 && next == 5 && !errorDone) {
                    corrupt(&f);
                    printf("Frame %d : CRC ERROR introduced\n", next);
                    errorDone = 1;
                }

                printf("Sending Frame %d : %s\n",
                       f.seq, f.codeword);

                sendAll(sock, &f, sizeof(f));
            }

            next++;
        }

        retries = 0;

        while (base < next) {
            if (getAck(sock, &a) < 0) {
                retries++;

                if (retries > 3) {
                    printf("Transmission failed\n");
                    close(sock);
                    return 1;
                }

                printf("Timeout waiting for ACK\n");
                printf("Retransmitting frames from %d\n", base);

                for (i = base; i < next; i++) {
                    Frame f;
                    makeFrame(&f, i, codes[i]);
                    printf("Retransmitting Frame %d : %s\n",
                           i, f.codeword);
                    sendAll(sock, &f, sizeof(f));
                }

                continue;
            }

            retries = 0;

            if (!strcmp(a.type, "ACK")) {
                ack = a.number;
                printf("ACK %d received\n", ack);

                if (ack >= base && ack < frameCount)
                    base = ack + 1;
            }
            else {
                ack = a.number;
                printf("Frame %d rejected by CRC\n", ack);
                printf("Retransmitting Frame %d\n", ack);

                if (ack >= 0 && ack < frameCount) {
                    Frame f;
                    makeFrame(&f, ack, codes[ack]);
                    sendAll(sock, &f, sizeof(f));
                }
            }
        }
    }

    {
        Frame end;
        makeFrame(&end, -1, "");
        sendAll(sock, &end, sizeof(end));
    }

    printf("\nAll frames transmitted successfully\n");

    close(sock);
    return 0;
}
