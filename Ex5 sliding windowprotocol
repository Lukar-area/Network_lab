#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define PORT 8082
#define SIZE 100
#define WINDOW_SIZE 7
#define FRAME_SIZE 8
#define MAX_CODEWORD 32

typedef struct {
    int seq, len;
    char codeword[MAX_CODEWORD];
} Frame;

typedef struct {
    char generator[SIZE];
    int mode, frameCount;
} Config;

typedef struct {
    char type[8];
    int number;
} Ack;

int sendAll(int s, void *p, int n)
{
    int x = 0, r;
    while (x < n) {
        r = send(s, (char *)p + x, n - x, 0);
        if (r <= 0) return -1;
        x += r;
    }
    return x;
}

int recvAll(int s, void *p, int n)
{
    int x = 0, r;
    while (x < n) {
        r = recv(s, (char *)p + x, n - x, 0);
        if (r <= 0) return -1;
        x += r;
    }
    return x;
}

int crcCheck(char *c, char *g)
{
    char t[MAX_CODEWORD];
    int n = strlen(c), m = strlen(g), i, j;

    if (m < 2 || n < m) return 0;
    strcpy(t, c);

    for (i = 0; i <= n - m; i++)
        if (t[i] == '1')
            for (j = 0; j < m; j++)
                t[i+j] = (t[i+j] == g[j]) ? '0' : '1';

    for (i = n-m+1; i < n; i++)
        if (t[i] == '1') return 0;

    return 1;
}

void ack(int s, char *type, int n)
{
    Ack a;
    memset(&a, 0, sizeof(a));
    strcpy(a.type, type);
    a.number = n;
    sendAll(s, &a, sizeof(a));
}

int main()
{
    int server, client, expected = 0;
    int mode, frameCount, ackLost = 0;
    struct sockaddr_in sa, ca;
    socklen_t len = sizeof(ca);
    Config cfg;
    Frame f;

    server = socket(AF_INET, SOCK_STREAM, 0);
    if (server < 0) {
        printf("Socket creation failed\n");
        return 1;
    }

    int opt = 1;
    setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    memset(&sa, 0, sizeof(sa));
    sa.sin_family = AF_INET;
    sa.sin_port = htons(PORT);
    sa.sin_addr.s_addr = htonl(INADDR_ANY);

    if (bind(server, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
        printf("Bind failed\n");
        return 1;
    }

    listen(server, WINDOW_SIZE);

    printf("Sliding Window TCP Server\n");
    printf("Window size : %d\n", WINDOW_SIZE);
    printf("Frame size  : %d bits\n", FRAME_SIZE);
    printf("Waiting for client...\n");

    client = accept(server, (struct sockaddr *)&ca, &len);
    if (client < 0) {
        printf("Accept failed\n");
        return 1;
    }

    if (recvAll(client, &cfg, sizeof(cfg)) < 0)
        return 1;

    mode = cfg.mode;
    frameCount = cfg.frameCount;

    printf("Generator : %s\n", cfg.generator);
    printf("Test case : %d\n\n", mode);

    while (expected < frameCount) {
        if (recvAll(client, &f, sizeof(f)) < 0)
            break;

        if (f.seq == -1)
            break;

        printf("Frame %d received : %s\n", f.seq, f.codeword);

        if (f.seq < expected) {
            printf("Duplicate Frame %d\n", f.seq);
            ack(client, "ACK", expected - 1);
            continue;
        }

        if (f.seq > expected) {
            printf("Frame %d is out of order\n", f.seq);
            ack(client, "ACK", expected - 1);
            continue;
        }

        if (!crcCheck(f.codeword, cfg.generator)) {
            printf("CRC status : ERROR\n");
            printf("Message status : DISCARDED\n");
            ack(client, "NACK", expected);
            continue;
        }

        printf("CRC status : ACCEPTED\n");

        if (mode == 2 && expected == 4 && !ackLost) {
            printf("ACK %d : ACKNOWLEDGEMENT LOST\n\n", expected);
            ackLost = 1;
            expected++;
            continue;
        }

        ack(client, "ACK", expected);
        printf("ACK %d sent\n\n", expected);
        expected++;
    }

    if (expected == frameCount)
        printf("All frames received successfully\n");

    close(client);
    close(server);
    return 0;
}
