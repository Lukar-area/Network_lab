#include"head.h"
int is_pow_two(int x)
{
    return x && !(x & (x - 1));
}

int compute(int m)
{
    int r = 0;
    while ((1 << r) < (m + r + 1))
    {
        r++;
    }
    return r;
}

void place_data(int code[], int n, int data[], int m)
{
    int di = 0;
    int pos;

    for (pos = 1; pos <= n; pos++)
    {
        if (is_pow_two(pos))
        {
            code[pos] = 0;
        }
        else
        {
            code[pos] = data[di++];
        }
    }
}

void calculate_parity(int code[], int n, int r)
{
    int i, pos;

    for (i = 0; i < r; i++)
    {
        int parity_pos = 1 << i;
        int sum = 0;

        for (pos = 1; pos <= n; pos++)
        {
            if (pos & parity_pos)
            {
                sum ^= code[pos];
            }
        }

        code[parity_pos] = sum;
    }
}

void print_codeword(int code[], int n)
{
    int pos;

    for (pos = n; pos >= 1; pos--)
    {
        printf("%d", code[pos]);
    }
    printf("\n");
}

int calculate_syndrome(int codeword[], int n, int r)
{
    int syn = 0;
    int i, pos;

    for (i = 0; i < r; i++)
    {
        int check_list = 1 << i;
        int sum = 0;

        for (pos = 1; pos <= n; pos++)
        {
            if (pos & check_list)
            {
                sum ^= codeword[pos];
            }
        }

        if (sum)
        {
            syn |= check_list;
        }
    }

    return syn;
}

