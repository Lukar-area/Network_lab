#include"head.h"
int main()
{
    int m;
    char s[32];

    printf("Enter data bits: ");
    scanf("%31s", s);

    m = strlen(s);

    int data[MAX_BITS];
    int i;

    for (i = 0; i < m; i++)
    {
        data[i] = s[i] - '0';
    }

    int r = compute(m);
    int n = m + r;

    printf("No. of redundant bits required: %d\n", r);
    printf("Code word length: %d\n", n);

    int codeword[MAX_BITS] = {0};

    place_data(codeword, n, data, m);
    calculate_parity(codeword, n, r);

    printf("Codeword: ");
    print_codeword(codeword, n);

    int ch;

    printf("Enter 1 to introduce error, 0 to continue: ");
    scanf("%d", &ch);

    int received[MAX_BITS];

    for (i = 1; i <= n; i++)
    {
        received[i] = codeword[i];
    }

    if (ch == 1)
    {
        int c;

        printf("Enter bit position to introduce error: ");
        scanf("%d", &c);

        if (c < 1 || c > n)
        {
            printf("Invalid position\n");
            return 0;
        }

        received[c] ^= 1;

        printf("Received codeword: ");
        print_codeword(received, n);
    }

    int syndrome = calculate_syndrome(received, n, r);

    printf("Syndrome: %d\n", syndrome);

    if (syndrome == 0)
    {
        printf("No error detected\n");
    }
    else if (syndrome <= n)
    {
        printf("Error detected at position: %d\n", syndrome);
        received[syndrome] ^= 1;
        printf("Corrected codeword: ");
        print_codeword(received, n);
        if (calculate_syndrome(received, n, r) == 0)
        {
            printf("Rechecking...\n");
            printf("No error detected\n");
        }
    }
    else
    {
        printf("Multiple errors detected\n");
    }
    printf("Extracted data bits: ");
    for (i = 1; i <= n; i++)
    {
        if (!is_pow_two(i))
        {
            printf("%d", received[i]);
        }
    }
    printf("\n");
    return 0;
}
