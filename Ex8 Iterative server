#include "head.h"

int main() {
    struct sockaddr_in address, client_address;
    socklen_t addr_len;
    int client_no = 0;

    int server = socket(AF_INET, SOCK_STREAM, 0);
    if (server < 0) {
        perror("Socket creation failed");
        return 1;
    }

    int opt = 1;
    if (setsockopt(server, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) < 0)
        perror("setsockopt failed");

    memset(&address, 0, sizeof(address));
    address.sin_family = AF_INET;
    address.sin_addr.s_addr = inet_addr("127.0.0.1");
    address.sin_port = htons(8083);

    if (bind(server, (struct sockaddr *)&address, sizeof(address)) < 0) {
        perror("Bind failed");
        close(server);
        return 1;
    }

    if (listen(server, 5) < 0) {
        perror("Listen failed");
        close(server);
        return 1;
    }

    printf("Server listening on 127.0.0.1:8083\n");

    while (1) {
        printf("Waiting for connection...\n");
        fflush(stdout);

        addr_len = sizeof(client_address);
        int client = accept(server, (struct sockaddr *)&client_address, &addr_len);
        if (client < 0) {
            perror("accept failed");
            continue;
        }

        char ip[INET_ADDRSTRLEN];
        inet_ntop(AF_INET, &client_address.sin_addr, ip, sizeof(ip));
        int port = ntohs(client_address.sin_port);
        client_no++;

        printf("Client %d connected!\n", client_no);
        printf("Client IP: %s\nClient port: %d\n", ip, port);
        fflush(stdout);
        send(client, "CONNECTED", sizeof("CONNECTED"), 0);

        int p = fork();
        if (p < 0) {
            perror("fork failed");
            close(client);
            continue;
        }

        if (p == 0) {
            close(server);
            char s[1000];

            while (1) {
                fd_set readfds;
                FD_ZERO(&readfds);
                FD_SET(client, &readfds);
                FD_SET(STDIN_FILENO, &readfds);
                int maxfd = client > STDIN_FILENO ? client : STDIN_FILENO;

                if (select(maxfd + 1, &readfds, NULL, NULL, NULL) < 0)
                    break;

                if (FD_ISSET(client, &readfds)) {
                    int n = recv(client, s, sizeof(s) - 1, 0);
                    if (n <= 0) {
                        printf("\nClient disconnected.\n");
                        break;
                    }
                    s[n] = '\0';
                    printf("\nC: %s\n", s);
                    if (strcmp(s, "0") == 0) {
                        printf("Client ended conversation.\n");
                        break;
                    }
                }

                if (FD_ISSET(STDIN_FILENO, &readfds)) {
                    printf("S: ");
                    fflush(stdout);
                    if (scanf("%999s", s) != 1)
                        break;
                    if (send(client, s, strlen(s) + 1, 0) <= 0) {
                        printf("Client disconnected.\n");
                        break;
                    }
                    if (strcmp(s, "0") == 0) {
                        printf("Server ended conversation.\n");
                        break;
                    }
                }
            }

            close(client);
            exit(0);
        } else {
            close(client);
            waitpid(p, NULL, 0);
            printf("Client %d disconnected.\n", client_no);
        }
    }

    close(server);
    return 0;
}
