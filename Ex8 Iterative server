#include "head.h"

int main() {
    struct sockaddr_in server;

    int sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("Socket creation failed");
        return 1;
    }

    memset(&server, 0, sizeof(server));
    server.sin_family = AF_INET;
    server.sin_addr.s_addr = inet_addr("127.0.0.1");
    server.sin_port = htons(8083);

    if (connect(sock, (struct sockaddr *)&server, sizeof(server)) < 0) {
        perror("Connection failed");
        close(sock);
        return 1;
    }

    printf("Waiting for connection...\n");
    fflush(stdout);

    char s[1000];
    int n = recv(sock, s, sizeof(s) - 1, 0);
    if (n <= 0) {
        printf("Server disconnected before accepting client.\n");
        close(sock);
        return 1;
    }
    s[n] = '\0';
    if (strcmp(s, "CONNECTED") != 0) {
        printf("Unexpected server response.\n");
        close(sock);
        return 1;
    }

    printf("Connected to server successfully!\n");

    int p = fork();
    if (p < 0) {
        perror("Fork failed");
        close(sock);
        return 1;
    }

    if (p == 0) {
        while (1) {
            int n = recv(sock, s, sizeof(s) - 1, 0);
            if (n <= 0) {
                printf("\nServer disconnected.\n");
                break;
            }
            s[n] = '\0';
            printf("\nS: %s\n", s);
            if (strcmp(s, "0") == 0) {
                printf("Server ended conversation.\n");
                break;
            }
        }
        kill(getppid(), SIGTERM);
        close(sock);
        exit(0);
    } else {
        while (1) {
            printf("C: ");
            fflush(stdout);
            if (scanf("%999s", s) != 1)
                break;
            if (send(sock, s, strlen(s) + 1, 0) <= 0)
                break;
            if (strcmp(s, "0") == 0)
                break;
        }
        close(sock);
        waitpid(p, NULL, 0);
    }

    return 0;
}
